# GAPSI Sentinel — variables de entorno de ejemplo.
# Copia este archivo a `.env.local` y ajusta los valores para tu entorno local.
# NO coloques secretos reales en este archivo; solo valores de ejemplo.

# Nombre visible de la aplicación.
NEXT_PUBLIC_APP_NAME="GAPSI Sentinel"

# Proveedor de autenticación activo para desarrollo local.
# En TASK-001 solo existe el adaptador "dev" (sesión simulada por cookie).
# No representa un proveedor real ni de producción.
AUTH_PROVIDER="dev"

# Nombre de la cookie de sesión usada por el adaptador de desarrollo.
AUTH_SESSION_COOKIE="gapsi_session"

# --- Base de datos (TASK-002) ---
# Credenciales SOLO de desarrollo (coinciden con compose.yml). NO son secretos reales.
# Estas variables las consume `compose.yml` para PostgreSQL local:
POSTGRES_USER="gapsi"
POSTGRES_PASSWORD="gapsi_dev_password"
POSTGRES_DB="gapsi_sentinel_dev"
POSTGRES_PORT="5432"

# Conexión que usa Prisma (debe coincidir con las variables de arriba).
DATABASE_URL="postgresql://gapsi:gapsi_dev_password@localhost:5432/gapsi_sentinel_dev?schema=public"

# Rol de aplicación con el que se aplican las políticas RLS (no superusuario).
# El superusuario/owner ignora RLS; la app debe conectarse con este rol.
# Ver docs/architecture/TASK-002-IMPLEMENTATION-NOTES.md.
# DATABASE_APP_URL="postgresql://gapsi_app:gapsi_app@localhost:5432/gapsi_sentinel_dev?schema=public"

# --- Módulo documental (TASK-004) ---
# Tamaño máximo de subida en bytes (por defecto 10 MB).
# DOCUMENTS_MAX_UPLOAD_BYTES=10485760
# Carpeta de almacenamiento local de archivos (por defecto ./storage/documents).
# DOCUMENTS_STORAGE_DIR=./storage/documents

# ==========================================================================
# PLATFORM-001 — variables RESERVADAS para producción (aún NO usadas por el
# runtime; se cablean en sus fases). Solo placeholders; NUNCA secretos reales.
# Catálogo tipado en src/server/env.ts. Ver docs/platform/ENVIRONMENTS.md.
# ==========================================================================

# Entorno lógico y URL pública (staging/producción).
# APP_ENV="local"                     # local | staging | production
# APP_URL="https://app.c3sentinel.com.mx"

# Conexión directa para migraciones cuando se usa pooling (PLATFORM-008).
# DIRECT_URL="postgresql://<user>:<pass>@<host>:5432/<db>?schema=public"

# Autenticación de producción (PLATFORM-003).
# AUTH_SECRET="<placeholder>"

# Object Storage S3-compatible, p. ej. Cloudflare R2 (PLATFORM-002).
# STORAGE_ENDPOINT="<placeholder>"
# STORAGE_BUCKET="<placeholder>"
# STORAGE_ACCESS_KEY="<placeholder>"
# STORAGE_SECRET_KEY="<placeholder>"

# Scheduler seguro para el processor de avisos (PLATFORM-006).
# CRON_SECRET="<placeholder>"

# Observabilidad y correo transaccional (futuro).
# SENTRY_DSN="<placeholder>"
# EMAIL_API_KEY="<placeholder>"

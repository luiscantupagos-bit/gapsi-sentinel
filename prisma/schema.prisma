/// Registro CAPA: no conformidad / desviación / hallazgo / mejora.
model Capa {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Folio legible `CAPA-AAAA-0001`, único por organización.
  folio          String
  year           Int
  title          String
  description    String
  /// source_type: internal_nc|audit_nc|deviation|customer_complaint|safety_incident|legal_noncompliance|documental_finding|out_of_spec|improvement|other
  sourceType     String @map("source_type")
  /// status: draft|reported|containment|under_investigation|action_plan|in_implementation|effectiveness_review|closed|cancelled
  status         String @default("draft")

  // Fuentes y relaciones (opcionales). Campos provisionales de texto para
  // producto/proceso mientras no exista una entidad formal.
  siteId            String? @map("site_id") @db.Uuid
  area              String?
  process           String?
  product           String?
  diagnosticId      String? @map("diagnostic_id") @db.Uuid
  documentId        String? @map("document_id") @db.Uuid
  documentVersionId String? @map("document_version_id") @db.Uuid
  requirementId     String? @map("requirement_id") @db.Uuid
  findingId         String? @map("finding_id") @db.Uuid
  externalReference String? @map("external_reference")

  // Identificación / clasificación.
  detectedAt        DateTime? @map("detected_at") @db.Timestamptz(6)
  reportedBy        String?   @map("reported_by") @db.Uuid
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// priority: low|normal|high|urgent
  priority          String    @default("normal")
  /// severity: low|medium|high|critical
  severity          String    @default("medium")
  /// impacts: subconjunto de quality|safety|legal|customer|product|process|personnel|environment|cost|reputation
  impacts           String[]  @default([])
  /// scope: point|batch|line|site|organization|customer|market
  scope             String    @default("point")
  targetDate        DateTime? @map("target_date") @db.Date
  tags              String[]  @default([])

  // Descripción estructurada del problema (5W2H + condición/requisito/evidencia).
  problemWhat         String? @map("problem_what")
  problemWhere        String? @map("problem_where")
  problemWhen         String? @map("problem_when")
  problemWhoDetect    String? @map("problem_who_detect")
  problemWhoAffect    String? @map("problem_who_affect")
  problemHowMuch      String? @map("problem_how_much")
  problemHow          String? @map("problem_how")
  conditionObserved   String? @map("condition_observed")
  requirementBreached String? @map("requirement_breached")
  objectiveEvidence   String? @map("objective_evidence")
  knownScope          String? @map("known_scope")
  knownRecurrence     String? @map("known_recurrence")
  relatedRefs         String? @map("related_refs")

  // Cierre y reapertura.
  closedBy        String?   @map("closed_by") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  closureSummary  String?   @map("closure_summary")
  closureChecksum String?   @map("closure_checksum")
  closureSnapshot Json?     @map("closure_snapshot")
  reopenCount     Int       @default(0) @map("reopen_count")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([organizationId, folio])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, responsibleUserId])
  @@index([organizationId, siteId])
  @@map("capas")
}


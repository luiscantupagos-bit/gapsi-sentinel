// =====================================================================
// TASK-010 — Auditorías, programas de auditoría y preparación
// El contenido normativo sigue siendo `template_versions` (fuente de verdad);
// cada auditoría CONGELA los requisitos seleccionados en snapshots inmutables.
// Punteros a otros módulos (framework/versión/requisito/documento/CAPA/tarea)
// son genéricos, validados por alcance en servidor + RLS. FK compuestas
// anti-cruce para relaciones intra-módulo y sitio. CHECK/RLS/append-only/
// no-borrado por SQL complementario.
// =====================================================================

/// Programa (plan) de auditorías por organización y año.
model AuditProgram {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  siteId            String?   @map("site_id") @db.Uuid
  folio             String
  name              String
  description       String?
  objective         String?
  scope             String?
  criteria          String?
  year              Int
  /// frequency: annual|semiannual|quarterly|custom
  frequency         String    @default("annual")
  responsibleUserId String?   @map("responsible_user_id") @db.Uuid
  /// status: draft|approved|active|completed|cancelled
  status            String    @default("draft")
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  tags              Json?
  metadata          Json?
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  items  AuditProgramItem[]
  files  AuditProgramFile[]
  audits Audit[]

  @@unique([organizationId, folio])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("audit_programs")
}

